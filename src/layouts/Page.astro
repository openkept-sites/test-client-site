---
// Shared layout. Markdown pages use it via `layout: ../layouts/Page.astro` in front matter.
const { frontmatter } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? 'Test Client Ltd';
const description = Astro.props.description ?? frontmatter?.description ?? 'Accountants in Exeter, Devon.';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | Test Client Ltd</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 0 auto; padding: 1rem; line-height: 1.6; color: #1b1f24; }
      header, footer { padding: 1rem 0; }
      nav a { margin-right: 1rem; color: #0b4f8a; }
      img { max-width: 100%; height: auto; }
      footer { border-top: 1px solid #ccd3da; margin-top: 3rem; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header>
      <nav aria-label="Main">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/blog">News</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Test Client Ltd is a fictional firm used to test Openkept's ok agent.</p>
    </footer>
  </body>
</html>
